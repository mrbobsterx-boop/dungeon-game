{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SaveGame",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "seed": { "type": "integer" },
    "player": {
      "type": "object",
      "properties": {
        "level": { "type": "integer" },
        "xp": { "type": "integer" },
        "maxDepthReached": { "type": "integer" },
        "unlockedSkills": { "type": "array", "items": { "type": "string" } },
        "inventory": { "type": "array" }
      }
    }
  },
  "required": ["version", "player"]
}
